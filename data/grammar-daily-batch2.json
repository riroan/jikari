[
  {
    "id": "particle-ni-wo-meet",
    "type": "particle_contrast",
    "jlptLevel": 5,
    "particles": [
      "に",
      "を"
    ],
    "rule": "한국어는 둘 다 '을/를'. を는 동작이 대상을 직접 다룰 때(기다리다·부르다), に는 상대나 도착점을 향할 때(만나다·타다)",
    "examples": [
      {
        "particle": "に",
        "jp": "{友達|ともだち}に{会|あ}う",
        "ko": "친구를 만난다"
      },
      {
        "particle": "に",
        "jp": "バスに{乗|の}る",
        "ko": "버스를 탄다"
      },
      {
        "particle": "を",
        "jp": "{友達|ともだち}を{待|ま}つ",
        "ko": "친구를 기다린다"
      },
      {
        "particle": "を",
        "jp": "{先生|せんせい}を{呼|よ}ぶ",
        "ko": "선생님을 부른다"
      }
    ],
    "quizzes": [
      {
        "sentence": "{駅|えき}で{友達|ともだち}＿＿＿{会|あ}う。",
        "correct": "に",
        "distractors": [
          "を",
          "で",
          "が"
        ],
        "translation": "역에서 친구를 만난다"
      },
      {
        "sentence": "{毎朝|まいあさ}{電車|でんしゃ}＿＿＿{乗|の}る。",
        "correct": "に",
        "distractors": [
          "を",
          "が",
          "と"
        ],
        "translation": "매일 아침 전철을 탄다"
      },
      {
        "sentence": "{駅|えき}で{友達|ともだち}＿＿＿{待|ま}つ。",
        "correct": "を",
        "distractors": [
          "に",
          "が",
          "の"
        ],
        "translation": "역에서 친구를 기다린다"
      }
    ]
  },
  {
    "id": "particle-ni-ga-naru",
    "type": "particle_contrast",
    "jlptLevel": 5,
    "particles": [
      "に",
      "が"
    ],
    "rule": "なる 앞의 '되는 결과'는 に (한국어 '이/가 되다'의 '가'를 그대로 옮기면 틀린다). 움직이거나 변하는 주체는 が",
    "examples": [
      {
        "particle": "に",
        "jp": "{医者|いしゃ}になる",
        "ko": "의사가 된다"
      },
      {
        "particle": "に",
        "jp": "{春|はる}になる",
        "ko": "봄이 된다"
      },
      {
        "particle": "が",
        "jp": "{雨|あめ}が{降|ふ}る",
        "ko": "비가 온다"
      },
      {
        "particle": "が",
        "jp": "{兄|あに}が{来|く}る",
        "ko": "형이 온다"
      }
    ],
    "quizzes": [
      {
        "sentence": "{姉|あね}は{先生|せんせい}＿＿＿なった。",
        "correct": "に",
        "distractors": [
          "が",
          "を",
          "で"
        ],
        "translation": "언니는 선생님이 되었다"
      },
      {
        "sentence": "もうすぐ{夏|なつ}＿＿＿なる。",
        "correct": "に",
        "distractors": [
          "が",
          "を",
          "で"
        ],
        "translation": "곧 여름이 된다"
      },
      {
        "sentence": "{子供|こども}＿＿＿{大人|おとな}になる。",
        "correct": "が",
        "distractors": [
          "に",
          "を",
          "で"
        ],
        "translation": "아이가 어른이 된다"
      }
    ]
  }
]
